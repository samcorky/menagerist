# Git must remain available as a BuildKit mount.
# .git

# Python
__pycache__
*.py[cod]
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Environments
.venv
venv
.env
.env.*

# IDEs
.vscode
.idea

# Frontend/build artefacts
frontend/node_modules
frontend/.svelte-kit
frontend/dist
frontend/build
node_modules
dist
build

# NOTE: docs/, README.md, LICENSE, .github/ used to be excluded here.
# They're git-tracked, and backend/Dockerfile bind-mounts this whole
# context read-only at /src as git's work tree, purely to compute build
# metadata (see backend/scripts/hatch_build_info.py) — excluding tracked
# paths made every build look dirty. Never reaches an image layer, so
# there's no runtime cost to including them.
