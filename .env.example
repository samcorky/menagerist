# Menagerist settings. Generated by `menagerist settings docs`; do not edit.
# Copy to .env next to compose.yaml and uncomment only what you change.
# Every variable is described in docs/settings.md.
# The Docker image sets MENAGERIST_API_FRONTEND_DIST_PATH=/app/frontend and
# MENAGERIST_SERVER_IN_CONTAINER=1 itself, so in a container those two differ from the
# defaults listed here.

# ==== API =============================================================================
# API entrypoint settings.

# The address people reach the app at, for example https://menagerist.example.com. Other
# settings default from it; each can still be set explicitly.
# MENAGERIST_API_PUBLIC_ORIGIN=

# Browser origins; empty means same-origin, '*' means any origin.
# Allowed: `*` on its own.
# MENAGERIST_API_CORS_ORIGINS=

# Built frontend directory; unset in API-only mode.
# MENAGERIST_API_FRONTEND_DIST_PATH=

# Trusted proxy IPs/CIDRs (CSV); '*' trusts all peers.
# Allowed: `*` on its own.
# MENAGERIST_API_TRUSTED_PROXIES=127.0.0.1

# ==== Backup ==========================================================================
# Instance backup storage, retention and upload limits.

# Directory used to store instance backup archives.
# MENAGERIST_BACKUP_PATH=/data/backups

# Hours to retain a person's downloadable data export.
# Allowed: more than 0.
# MENAGERIST_BACKUP_USER_EXPORT_TTL_HOURS=24

# Create a backup before applying database migrations. Enabled by default.
# MENAGERIST_BACKUP_BEFORE_MIGRATE=true

# Minimum number of ordinary backups to retain.
# Allowed: 1 or more.
# MENAGERIST_BACKUP_KEEP_LAST=7

# Minimum number of pre-migration backups to retain.
# Allowed: 1 or more.
# MENAGERIST_BACKUP_PRE_MIGRATION_KEEP=3

# Cron expression for scheduled backups in the instance timezone. Empty disables
# scheduled backups; each success is followed by retention.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_BACKUP_SCHEDULE="0 3 * * *"

# Cron expression for expiring downloadable data exports. Empty disables the job.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_BACKUP_PRUNE_EXPORTS_SCHEDULE="0 * * * *"

# Maximum accepted backup archive upload size in bytes.
# Allowed: more than 0.
# MENAGERIST_BACKUP_MAX_UPLOAD_SIZE=8589934592

# ==== Database ========================================================================
# Database connection settings.

# PostgreSQL connection URL for the backend database.
# Sensitive: no default is written here.
# Best given as a secrets file.
# MENAGERIST_DATABASE_URL=

# ==== Identity ========================================================================
# Configuration for the identity module.

# Maximum lifetime of a session in hours, even while it is active.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_SESSION_TTL_HOURS=168

# Idle timeout in hours; 0 disables this limit.
# Allowed: 0 or more.
# MENAGERIST_IDENTITY_SESSION_IDLE_HOURS=0

# Cron expression for removing expired sessions and API tokens in the instance timezone.
# Empty disables the job.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_IDENTITY_PURGE_EXPIRED_SCHEDULE="15 4 * * *"

# Name of the HTTP-only session cookie.
# Allowed: matching `` ^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$ ``.
# MENAGERIST_IDENTITY_COOKIE_NAME=menagerist-session

# Secure session cookies: auto detects HTTPS from each request, origin follows the
# scheme of api.public_origin, always and never force it.
# Allowed: `auto`, `origin`, `always`, `never`.
# MENAGERIST_IDENTITY_COOKIE_SECURE=auto

# Password-hashing scheme used for newly created password hashes.
# Allowed: `scrypt`.
# MENAGERIST_IDENTITY_PASSWORD_HASHER=scrypt

# Failed sign-ins allowed per username in each throttle window.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_SIGN_IN_USERNAME_ATTEMPTS=5

# Failed sign-ins allowed per IP address in each throttle window.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_SIGN_IN_IP_ATTEMPTS=20

# Failed API-token checks allowed per IP address per window.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_API_TOKEN_IP_ATTEMPTS=20

# Duration of the failed sign-in throttle window in minutes.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_SIGN_IN_WINDOW_MINUTES=15

# Maximum number of simultaneous password-hash operations in this process.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_PASSWORD_HASH_CONCURRENCY=2

# Lifetime in days offered for a new API token.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_API_TOKEN_DEFAULT_DAYS=90

# Longest lifetime in days an API token may be given.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_API_TOKEN_MAX_DAYS=365

# Most active API tokens one person may hold.
# Allowed: 1 or more.
# MENAGERIST_IDENTITY_API_TOKENS_PER_USER=20

# Optional first-admin password; prefer its Docker secret file.
# Sensitive: no default is written here.
# Best given as a secrets file.
# MENAGERIST_IDENTITY_INITIAL_PASSWORD=

# ==== Log =============================================================================
# Logging settings.

# Minimum severity emitted by Menagerist application loggers.
# Allowed: `CRITICAL`, `ERROR`, `WARNING`, `INFO`, `DEBUG`, `NOTSET`.
# MENAGERIST_LOG_LEVEL=INFO

# Minimum severity emitted by SQLAlchemy's engine logger.
# Allowed: `CRITICAL`, `ERROR`, `WARNING`, `INFO`, `DEBUG`, `NOTSET`.
# MENAGERIST_LOG_SQLALCHEMY_LEVEL=WARNING

# Emit structured logs as JSON instead of the development format.
# MENAGERIST_LOG_JSON_OUTPUT=false

# Emit HTTP access log entries for application requests.
# MENAGERIST_LOG_ACCESS=true

# ==== Media ===========================================================================
# Configuration for the media module.

# Directory used to store uploaded media and generated assets.
# MENAGERIST_MEDIA_STORAGE_PATH=/data/media

# Cron expression for removing expired unattached and unreferenced media in the instance
# timezone. Empty disables the job.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_MEDIA_CLEANUP_SCHEDULE="30 * * * *"

# Cron expression for removing stored files that no upload refers to, in the instance
# timezone. Empty disables the job.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_MEDIA_STRAY_FILES_SCHEDULE="45 3 * * 0"

# Hours to keep media uploads that have not been attached.
# Allowed: 1 or more.
# MENAGERIST_MEDIA_STAGED_TTL_HOURS=24

# Hours to keep media files that are no longer referenced.
# Allowed: 1 or more.
# MENAGERIST_MEDIA_ORPHANED_TTL_HOURS=72

# Maximum accepted media upload size in bytes.
# Allowed: more than 0.
# MENAGERIST_MEDIA_MAX_UPLOAD_SIZE=104857600

# ==== Rate_Limit ======================================================================
# Request limits on the endpoints that are expensive to serve.

# Media and backup uploads allowed per user each minute.
# Allowed: 0 or more.
# MENAGERIST_RATE_LIMIT_UPLOADS_PER_MINUTE=30

# Thumbnail requests allowed per user each minute.
# Allowed: 0 or more.
# MENAGERIST_RATE_LIMIT_THUMBNAILS_PER_MINUTE=600

# Item searches allowed per user each minute.
# Allowed: 0 or more.
# MENAGERIST_RATE_LIMIT_SEARCH_PER_MINUTE=120

# Preset and user-data imports allowed per user each minute.
# Allowed: 0 or more.
# MENAGERIST_RATE_LIMIT_IMPORTS_PER_MINUTE=10

# ==== Release =========================================================================
# Which releases the instance looks for and how often.

# Releases to report: stable only, or preview, which also includes release candidates
# and other prereleases.
# Allowed: `stable`, `preview`.
# MENAGERIST_RELEASE_CHANNEL=stable

# Cron expression for looking for a newer release in the instance timezone. Empty turns
# the scheduled check off; an administrator can still check from the Status page.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_RELEASE_CHECK_SCHEDULE="20 5 * * *"

# ==== Retention =======================================================================
# How long deleted content stays recoverable before it is purged.

# Days deleted content stays recoverable before it is purged.
# Allowed: 1 or more.
# MENAGERIST_RETENTION_DELETED_DAYS=30

# Cron expression for permanently removing content older than the retention period, in
# the instance timezone. Empty, the default, leaves it to the data purge-deleted
# command.
# Allowed: five fields; empty turns the job off.
# MENAGERIST_RETENTION_PURGE_SCHEDULE=

# ==== Scheduler =======================================================================
# Instance timezone, worker liveness and job history retention.

# Timezone used to interpret recurring job schedules.
# Also read from TZ.
# MENAGERIST_TIMEZONE=UTC

# Number of completed runs to retain for each job.
# Allowed: 1 or more.
# MENAGERIST_SCHEDULER_RUN_HISTORY_PER_JOB=100

# Seconds without a worker heartbeat before liveness checks warn.
# Allowed: more than 0.
# MENAGERIST_SCHEDULER_WORKER_HEARTBEAT_TIMEOUT_SECONDS=300

# Seconds between the worker's liveness heartbeats.
# Allowed: more than 0.
# MENAGERIST_SCHEDULER_WORKER_HEARTBEAT_INTERVAL_SECONDS=60

# ==== Server ==========================================================================
# How many web worker processes run, and whether this is a container.

# Web worker processes, 1 to 16, or auto: one per CPU core on a host and one in a
# container or when reloading, as Granian advises.
# Allowed: 1 to 16, `auto`.
# MENAGERIST_SERVER_WORKERS=auto

# Whether the server runs in a container. Unset detects it; the image sets it, and 0 or
# 1 overrides detection.
# MENAGERIST_SERVER_IN_CONTAINER=

# ==== Terminal ========================================================================
# What the terminal the process writes to can show.

# Set to any value that does not start with 0 to turn off colour in console logs (see
# https://no-color.org).
# NO_COLOR=

# ==== Compose =========================================================================
# Read by Docker Compose from `.env` when it starts the stack, not by Menagerist.
# Recreate the stack after changing one.

# Image the app and worker run. Set a version tag to pin a release or to roll back (see
# docs/DEPLOYING.md). The development override (compose.override.yml) defaults it to
# `menagerist:local`.
# MENAGERIST_IMAGE=ghcr.io/samcorky/menagerist:latest

# The database container's hard memory cap (Postgres has no limit of its own). Raise it
# together with the memory values below if the database is large.
# POSTGRES_MEM_LIMIT=512m

# Postgres `shared_buffers` (its own default is 128MB). About a quarter of the memory
# cap; the most useful one to raise on a bigger machine.
# POSTGRES_SHARED_BUFFERS=128MB

# Postgres `effective_cache_size` (its own default is 4GB), a planner hint for how much
# data the OS can cache. Keep it near half the memory cap so the planner is not too
# optimistic.
# POSTGRES_EFFECTIVE_CACHE_SIZE=256MB

# Postgres `work_mem` (its own default is 4MB), the memory per sort or hash in a query.
# Raise it only if large sorts spill to disk, as it applies to each step of each
# connection.
# POSTGRES_WORK_MEM=4MB

# Postgres `max_connections` (its own default is 100). Each worker process keeps a pool
# of connections: lower it on a very small machine, and keep it above the total of all
# pools.
# POSTGRES_MAX_CONNECTIONS=100
