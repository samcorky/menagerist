{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "security:openssf-scorecard",
    "security:minimumReleaseAgePypi"
  ],
  "ignorePresets": [
    "abandonments:recommended"
  ],
  "timezone": "UTC",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/__fixtures__/**"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "osvVulnerabilityAlerts": true,
  "abandonmentThreshold": "3 years",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "constraints": {
    "node": "^26.0.0"
  },
  "npmrc": "allow-remote=all\ninstall-strategy=hoisted\n",
  "postUpdateOptions": [
    "npmDedupe"
  ],
  "schedule": [
    "before 6am on saturday",
    "before 6am on sunday",
    "before 6am on monday"
  ],
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "prConcurrentLimit": 8,
  "prHourlyLimit": 10,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "dependencies"
    ],
    "schedule": [
      "at any time"
    ],
    "automerge": true,
    "platformAutomerge": true,
    "semanticCommitType": "fix",
    "semanticCommitScope": "security",
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true,
    "platformAutomerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Python floor in requires-python, so it moves with .python-version in one pull request",
      "managerFilePatterns": [
        "/^pyproject\\.toml$/",
        "/^backend/pyproject\\.toml$/"
      ],
      "matchStrings": [
        "requires-python = \">=(?<currentValue>3\\.\\d+)\""
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Postgres image testcontainers starts, so it moves with compose.yaml",
      "managerFilePatterns": [
        "/^backend/tests/conftest\\.py$/"
      ],
      "matchStrings": [
        "PostgresContainer\\(\"(?<depName>postgres):(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Tell the two lock file maintenance pull requests apart (they share a title otherwise)",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "npm"
      ],
      "commitMessageSuffix": "(frontend)"
    },
    {
      "description": "Tell the two lock file maintenance pull requests apart (they share a title otherwise)",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "pep621"
      ],
      "commitMessageSuffix": "(backend)"
    },
    {
      "description": "Our own image is not a dependency to track: compose.yaml ships `latest` on purpose (a digest would freeze every new install on one build), and the compose.smoke.yaml tag is built locally",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "ghcr.io/samcorky/menagerist",
        "menagerist"
      ],
      "enabled": false
    },
    {
      "description": "The proxy harness images float on purpose: it exists to notice when a new nginx, Caddy or Traefik release changes how an early upload reply is relayed, so a digest pin would freeze it and add a weekly digest pull request for test-only images",
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "compose.proxy.yaml"
      ],
      "pinDigests": false
    },
    {
      "description": "One Postgres bump updates compose.yaml and backend/tests/conftest.py together. No digest pin: the CI image cache is keyed on the compose.yaml name and the tests ask for the tag",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "groupName": "postgres image",
      "pinDigests": false,
      "automerge": false
    },
    {
      "description": "The Playwright image the e2e jobs run in must be the same version as @playwright/test, or the browsers it ships are not the ones the library asks for",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "playwright",
      "automerge": false
    },
    {
      "description": "Group all Python interpreter version bumps (.python-version and the requires-python floors) into one PR, and treat as a major/manual-review change",
      "matchManagers": [
        "pyenv",
        "custom.regex"
      ],
      "matchPackageNames": [
        "python"
      ],
      "groupName": "python interpreter version",
      "commitMessageTopic": "Python interpreter",
      "automerge": false,
      "labels": [
        "python-version"
      ]
    },
    {
      "description": "Group Python runtime dependencies (project.dependencies)",
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchDepTypes": [
        "dependencies",
        "project.dependencies"
      ],
      "groupName": "python runtime dependencies"
    },
    {
      "description": "Group Python dev/tooling dependencies (dependency-groups.dev and release)",
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "groupName": "python dev dependencies"
    },
    {
      "description": "Group Python build-system requirements (build-system.requires)",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "build-system.requires"
      ],
      "groupName": "python build system"
    },
    {
      "description": "TypeScript 7 is outside the peer range of SvelteKit 2 (typescript ^5.3.3 || ^6.0.0); remove once SvelteKit supports it",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "SvelteKit 3 cannot install while bits-ui depends on runed 0.35 (peer @sveltejs/kit ^2.21.0); the adapter must match SvelteKit. Remove once bits-ui moves to a runed that accepts SvelteKit 3",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@sveltejs/kit",
        "@sveltejs/adapter-static"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Frontend (npm) updates are grouped by how they fail, not all together, so one bad release blocks only its own group. Later rules override this catch-all; each major update gets its own pull request",
      "matchManagers": [
        "npm"
      ],
      "groupName": "frontend dependencies (other)",
      "separateMultipleMajor": true
    },
    {
      "description": "The Svelte toolchain is coupled by peer ranges, so it moves in one pull request, majors included",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "svelte",
        "svelte-check",
        "/^@sveltejs\\//",
        "/^vite/"
      ],
      "groupName": "frontend svelte toolchain",
      "separateMajorMinor": false
    },
    {
      "description": "Lint and format tooling only affects lint results, so its minor and patch updates automerge once CI passes",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "globals",
        "prettier",
        "typescript-eslint",
        "/^@eslint\\//",
        "/^eslint-/",
        "/^prettier-/"
      ],
      "groupName": "frontend lint and format tooling",
      "separateMultipleMajor": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "UI libraries change what users see and are where e2e regressions come from",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@internationalized/date",
        "@lucide/svelte",
        "shadcn-svelte",
        "svelte-sonner",
        "tailwind-merge",
        "tailwind-variants",
        "tailwindcss",
        "tw-animate-css",
        "/^@tailwindcss\\//"
      ],
      "groupName": "frontend ui libraries",
      "separateMultipleMajor": true
    },
    {
      "description": "bits-ui gets its own pull request: 2.20 fails advanced-search.spec.ts:166 and field-types.spec.ts:209, and it holds back SvelteKit 3, so it should not block the other UI libraries",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "bits-ui"
      ],
      "groupName": null
    },
    {
      "description": "Runtime npm dependencies ship to users and need a manual review; keeping them in their own group lets the dev-only groups above automerge instead of one runtime package making the whole group manual",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "groupName": "frontend runtime dependencies",
      "separateMultipleMajor": true
    },
    {
      "description": "Group GitHub Actions updates together and pin SHA digests",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": true
    },
    {
      "description": "Automerge GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Group pre-commit hook updates together",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Automerge pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Automerge non-major devDependency and lint/format tooling updates",
      "matchDepTypes": [
        "devDependencies",
        "dependency-groups"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Require manual review for all major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual review for runtime/production dependencies",
      "matchDepTypes": [
        "dependencies",
        "project.dependencies"
      ],
      "automerge": false
    },
    {
      "description": "One pull request pins all npm packages (otherwise there are several, all titled Pin dependencies)",
      "matchUpdateTypes": [
        "pin"
      ],
      "matchManagers": [
        "npm"
      ],
      "groupName": "pin npm dependencies",
      "commitMessageSuffix": "(npm)"
    },
    {
      "description": "One pull request pins the Docker images by digest",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "pin docker images",
      "commitMessageSuffix": "(docker images)"
    },
    {
      "description": "hatchling, hatch-vcs and calver-scm are pinned in build-system.requires and in a dependency group; keep both in one pull request so they move together",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "hatchling",
        "hatch-vcs",
        "calver-scm"
      ],
      "groupName": "python build system"
    },
    {
      "description": "Workflow and composite action updates are CI changes",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "Docker images and the Python build system are build changes",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "semanticCommitType": "build"
    },
    {
      "description": "Build-system requirements (hatchling, hatch-vcs, calver-scm) are build changes",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "build-system.requires"
      ],
      "semanticCommitType": "build"
    },
    {
      "description": "Group Node version bumps (.node-version, which CI and the Dockerfile read, the engines.node range in frontend/package.json, the Renovate tool constraint and the @types/node typings) into one PR, and treat as a major/manual-review change. Matched by package name alone, because the tool constraint comes from no single manager, and kept last because a later rule would override its group (the npm catch-all and the major rule both do). separateMultipleMajor is off because the npm catch-all turns it on, which split these into one pull request per major",
      "matchDepNames": [
        "node",
        "@types/node"
      ],
      "groupName": "node version",
      "separateMultipleMajor": false,
      "commitMessageTopic": "Node",
      "semanticCommitType": "build",
      "automerge": false,
      "labels": [
        "node-version"
      ]
    }
  ]
}
