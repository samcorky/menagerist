{
  "description": "Generated starts-with and ends-with patterns, and the built-in phone and partial date patterns, must give the same result in Python re.search and JavaScript RegExp with the u flag. Read by the backend and frontend suites.",
  "cases": [
    {
      "pattern": "^cover-",
      "value": "cover-front.jpg",
      "expected": true
    },
    {
      "pattern": "^cover-",
      "value": "back-cover-front.jpg",
      "expected": false
    },
    {
      "pattern": "^cover-",
      "value": "",
      "expected": false
    },
    {
      "pattern": "\\.jpg$",
      "value": "cover-front.jpg",
      "expected": true
    },
    {
      "pattern": "\\.jpg$",
      "value": "cover-front.jpg.png",
      "expected": false
    },
    {
      "pattern": "\\.jpg$",
      "value": "xjpg",
      "expected": false
    },
    {
      "pattern": "^LP-",
      "value": "LP-001",
      "expected": true
    },
    {
      "pattern": "^\\(a\\)",
      "value": "(a) b",
      "expected": true
    },
    {
      "pattern": "^\\(a\\)",
      "value": "a b",
      "expected": false
    },
    {
      "pattern": "\\[x\\]$",
      "value": "done [x]",
      "expected": true
    },
    {
      "pattern": "\\[x\\]$",
      "value": "done x",
      "expected": false
    },
    {
      "pattern": "^a\\/b",
      "value": "a/b/c",
      "expected": true
    },
    {
      "pattern": "^a\\/b",
      "value": "ab",
      "expected": false
    },
    {
      "pattern": "^\\\\server",
      "value": "\\server\\share",
      "expected": true
    },
    {
      "pattern": "^\\\\server",
      "value": "server",
      "expected": false
    },
    {
      "pattern": "^a\\+b\\*c\\?",
      "value": "a+b*c?",
      "expected": true
    },
    {
      "pattern": "^a\\+b\\*c\\?",
      "value": "aab",
      "expected": false
    },
    {
      "pattern": "^\\{1\\}\\|\\^",
      "value": "{1}|^x",
      "expected": true
    },
    {
      "pattern": "^caf\u00e9",
      "value": "caf\u00e9 au lait",
      "expected": true
    },
    {
      "pattern": "^caf\u00e9",
      "value": "cafe",
      "expected": false
    },
    {
      "pattern": "^\ud83c\udfb5",
      "value": "\ud83c\udfb5 song",
      "expected": true
    },
    {
      "pattern": "^\ud83c\udfb5",
      "value": "song",
      "expected": false
    },
    {
      "pattern": "^a-b",
      "value": "a-b",
      "expected": true
    },
    {
      "pattern": "^a-b",
      "value": "a_b",
      "expected": false
    },
    {
      "pattern": "^[0-9+()\\-\\s]{3,32}$",
      "value": "+1 (555) 123-4567",
      "expected": true
    },
    {
      "pattern": "^[0-9+()\\-\\s]{3,32}$",
      "value": "123",
      "expected": true
    },
    {
      "pattern": "^[0-9+()\\-\\s]{3,32}$",
      "value": "12",
      "expected": false
    },
    {
      "pattern": "^[0-9+()\\-\\s]{3,32}$",
      "value": "123456789012345678901234567890123",
      "expected": false
    },
    {
      "pattern": "^[0-9+()\\-\\s]{3,32}$",
      "value": "call me",
      "expected": false
    },
    {
      "pattern": "^[0-9+()\\-\\s]{3,32}$",
      "value": "",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973",
      "expected": true
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03",
      "expected": true
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03-14",
      "expected": true
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-01-01",
      "expected": true
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-12-31",
      "expected": true
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "0001",
      "expected": true
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "73",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "19730",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-3",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-13",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-00",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03-32",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03-00",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03-1",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03-14x",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973/03/14",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": " 1973",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973 ",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-03-",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "\u0661\u0669\u0667\u0663",
      "expected": false
    },
    {
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "value": "1973-\u0660\u0663",
      "expected": false
    }
  ]
}
