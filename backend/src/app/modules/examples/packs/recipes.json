            "quantity": {
              "value": 1,
              "unit": "tsp"
            }
          }
        ],
        "method": [
          "Heat the oven to 220C and flour a baking tray.",
          "Soften the sliced leek in a little butter, then let it cool.",
          "Rub the butter into the flour, baking powder and mustard powder.",
          "Stir in most of the cheddar and the leek, then mix to a soft dough with the milk and egg.",
          "Pat out to 3 cm thick, cut into rounds and scatter with the rest of the cheddar.",
          "Bake for 15 to 20 minutes until risen and golden."
        ],
        "notes": "Best eaten warm, with too much butter."
