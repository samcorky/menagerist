            }
          },
          {
            "ingredient": "Milk",
            "quantity": {
              "value": 2,
              "unit": "tbsp"
            }
          }
        ],
        "method": [
          "Heat the oven to 150C and line a square tin.",
          "Melt the butter, treacle, syrup and sugar gently together and let it cool a little.",
          "Mix the flour, oatmeal and ginger in a bowl.",
          "Stir in the melted mixture, then the beaten egg and milk to a pourable batter.",
          "Bake for 1 hour until firm, then keep it in the tin for three days before cutting."
        ],
        "notes": "Improves if left in the tin for three days. Almost impossible to manage."
