    {
      "ref": "cheese-and-onion-pie",
      "type": "recipe",
      "name": "Cheese and onion pie",
      "description": "The pie that settles every argument.",
      "attributes": {
        "servings": 6,
        "prep_time": 1800,
        "cook_time": 2700,
        "dietary": [
          "Vegetarian"
        ],
        "rating": 5,
        "ingredients": [
          {
            "ingredient": "Plain flour",
            "quantity": {
              "value": 300,
              "unit": "g"
            }
          },
          {
            "ingredient": "Butter",
            "quantity": {
              "value": 150,
              "unit": "g"
            }
          },
          {
            "ingredient": "Mature cheddar",
            "quantity": {
              "value": 250,
              "unit": "g"
            }
          },
          {
            "ingredient": "Onions",
            "quantity": {
              "value": 3,
              "unit": "whole"
            }
          },
          {
            "ingredient": "Potatoes",
            "quantity": {
              "value": 400,
              "unit": "g"
            }
          },
          {
            "ingredient": "Egg",
            "quantity": {
              "value": 1,
              "unit": "whole"
            }
          },
          {
            "ingredient": "Milk",
            "quantity": {
              "value": 2,
              "unit": "tbsp"
            }
          }
        ],
        "method": [
          "Rub the butter into the flour, bind with a splash of cold water and chill.",
          "Boil the potatoes until just tender and soften the onions slowly in butter.",
          "Mix both with the grated cheddar and plenty of black pepper.",
          "Line a tin with two thirds of the pastry, fill it and add a lid.",
          "Brush with the beaten egg and milk, then bake at 200C for 45 minutes until deep golden."
        ],
        "notes": "Nan said never use mild cheddar. Serve with brown sauce, obviously."
      },
      "tags": [
        "pie",
        "comfort food"
      ]
    },
