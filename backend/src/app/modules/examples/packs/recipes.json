              }
            },
            "x-menagerist": {
              "columns": [
                "ingredient",
                "quantity"
              ],
              "kind": "group"
            }
          },
          "method": {
            "title": "Method",
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-menagerist": {
              "kind": "list"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "longtext"
            }
          }
        },
