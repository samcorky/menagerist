{
  "format": "menagerist-example-pack",
  "version": 1,
  "id": "parts",
  "relationship_types": [
    {
      "ref": "used-in",
      "slug": "parts-used-in",
      "label": "Used in",
      "reverse_label": "Uses",
      "description": "Which assemblies a part goes into, and how many.",
      "directional": true,
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "quantity": {
            "title": "Quantity",
            "type": "number",
            "x-menagerist": {
              "kind": "number"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "quantity"
            }
          ],
          "required": []
        }
      }
    },
    {
      "ref": "supplied-by",
      "slug": "parts-supplied-by",
      "label": "Supplied by",
      "reverse_label": "Supplies",
      "description": "Who sells a part, and at what price.",
      "directional": true,
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "price": {
            "title": "Price",
            "type": "object",
            "properties": {
              "value": {
                "title": "Value",
                "type": "number"
              },
              "currency": {
                "title": "Currency",
                "type": "string"
              }
            },
            "x-menagerist": {
              "kind": "money"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "price"
            }
          ],
          "required": []
        }
      }
    }
  ],
  "item_types": [
    {
      "ref": "part",
      "slug": "parts-part",
      "label": "Part",
      "description": "A component or consumable in the parts drawer.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "part_number": {
            "title": "Part number",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          },
          "in_stock": {
            "title": "In stock",
            "type": "number",
            "x-menagerist": {
              "kind": "number"
            }
          },
          "reorder_at": {
            "title": "Reorder at",
            "type": "number",
            "x-menagerist": {
              "kind": "number"
            }
          },
          "typical_price": {
            "title": "Typical price",
            "type": "object",
            "properties": {
              "value": {
                "title": "Value",
                "type": "number"
              },
              "currency": {
                "title": "Currency",
                "type": "string"
              }
            },
            "x-menagerist": {
              "kind": "money"
            }
          },
          "datasheet": {
            "title": "Datasheet",
            "type": "string",
            "format": "uri",
            "x-menagerist": {
              "kind": "url"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "part_number"
            },
            {
              "key": "in_stock"
            },
            {
              "key": "reorder_at"
            },
            {
              "key": "typical_price"
            },
            {
              "key": "datasheet"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "in_stock"
              },
              {
                "key": "reorder_at"
              },
              {
                "key": "typical_price"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "assembly",
      "slug": "parts-assembly",
      "label": "Assembly",
      "description": "Something you have built, or are building, from the drawer.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "built": {
            "title": "Built",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          },
          "build_steps": {
            "title": "Build steps",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Text",
                  "type": "string"
                },
                "done": {
                  "title": "Done",
                  "type": "boolean"
                }
              }
            },
            "x-menagerist": {
              "kind": "checklist"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "longtext"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "built"
            },
            {
              "key": "build_steps"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "built"
              },
              {
                "key": "build_steps"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "supplier",
      "slug": "parts-supplier",
      "label": "Supplier",
      "description": "A shop you buy parts from.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "website": {
            "title": "Website",
            "type": "string",
            "format": "uri",
            "x-menagerist": {
              "kind": "url"
            }
          },
          "email": {
            "title": "Email",
            "type": "string",
            "format": "email",
            "x-menagerist": {
              "kind": "email"
            }
          },
          "phone": {
            "title": "Phone",
            "type": "string",
            "pattern": "^[0-9+()\\-\\s]{3,32}$",
            "x-menagerist": {
              "kind": "phone"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "website"
            },
            {
              "key": "email"
            },
            {
              "key": "phone"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "website"
              },
              {
                "key": "phone"
              }
            ]
          }
        }
      }
    }
  ],
