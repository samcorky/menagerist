{
  "format": "menagerist-example-pack",
  "version": 7,
  "id": "conventions",
  "relationship_types": [
    {
      "ref": "on",
      "slug": "conventions-on",
      "label": "On",
      "reverse_label": "Signatures",
      "description": "Which collectable a signature is on.",
      "directional": true
    },
    {
      "ref": "signed-by",
      "slug": "conventions-signed-by",
      "label": "Signed by",
      "reverse_label": "Signatures",
      "description": "Who made a signature.",
      "directional": true
    },
    {
      "ref": "at",
      "slug": "conventions-at",
      "label": "At",
      "reverse_label": "Hosted",
      "description": "The event where a signature, photo or print came from.",
      "directional": true
    },
    {
      "ref": "with",
      "slug": "conventions-with",
      "label": "Shows",
      "reverse_label": "Appears in",
      "description": "Who is in a photo or on a print.",
      "directional": true
    }
  ],
  "item_types": [
    {
      "ref": "collectable",
      "slug": "conventions-collectable",
      "icon": "image",
      "colour": "amber",
      "label": "Collectable",
      "description": "A poster, print or programme you have collected, signed or not.",
      "cover": {
        "style": "poster"
      },
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string",
            "enum": [
              "Poster",
              "Photo print",
              "Programme",
              "Ticket"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          },
          "size": {
            "title": "Size",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          },
          "condition": {
            "title": "Condition",
            "type": "string",
            "enum": [
              "Mint",
              "Near Mint",
              "Very Good",
              "Good",
              "Fair",
              "Poor"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          },
          "framed": {
            "title": "Framed",
            "type": "boolean",
            "x-menagerist": {
              "kind": "boolean"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "longtext"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "kind"
            },
            {
              "key": "size"
            },
            {
              "key": "condition"
            },
            {
              "key": "framed"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "kind"
              },
              {
                "key": "condition"
              },
              {
                "key": "framed"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "person",
      "slug": "conventions-person",
      "icon": "user",
      "colour": "blue",
      "label": "Person",
      "description": "A guest you have met, or someone who came along with you, such as family and friends.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "known_for": {
            "title": "Known for",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "known_for"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "known_for"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "event",
      "slug": "conventions-event",
      "icon": "tickets",
      "colour": "teal",
      "label": "Event",
      "description": "A convention, fair or signing session.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string",
            "format": "date",
            "x-menagerist": {
              "kind": "date"
            }
          },
          "city": {
            "title": "City",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          },
          "kind": {
            "title": "Kind",
            "type": "string",
            "enum": [
              "Convention",
              "Collectors fair",
              "Signing session"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "date"
            },
            {
              "key": "city"
            },
            {
              "key": "kind"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "date"
              },
              {
                "key": "city"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "photo",
      "slug": "conventions-photo",
      "icon": "camera",
      "colour": "pink",
      "label": "Photo",
      "description": "A selfie, photo op or photoshoot with a guest.",
      "cover": {
        "style": "card"
      },
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string",
            "enum": [
              "Selfie",
              "Photo op",
              "Photoshoot",
              "Group photo"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          },
          "taken_on": {
            "title": "Taken on",
            "type": "string",
            "format": "date",
            "x-menagerist": {
              "kind": "date"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "longtext"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "kind"
            },
            {
              "key": "taken_on"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "kind"
              },
              {
                "key": "taken_on"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "signature",
      "slug": "conventions-signature",
      "icon": "pen-tool",
      "colour": "violet",
      "label": "Signature",
      "description": "One signature on one collectable. It links to the collectable, the person who signed and the event, so a piece signed by many people at many events keeps each story apart.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "signed_on": {
            "title": "Signed on",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          },
          "position": {
            "title": "Position and pen",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          },
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean",
            "x-menagerist": {
              "kind": "boolean"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "signed_on"
            },
            {
              "key": "position"
            },
            {
              "key": "authenticated"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "signed_on"
              },
              {
                "key": "authenticated"
              }
            ]
          }
        }
      }
    }
