    },
    {
      "ref": "played-at",
      "slug": "games-played-at",
      "label": "Played at",
      "reverse_label": "Played",
      "description": "Which games came out on a game night, and who won.",
      "directional": true,
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "winner": {
            "title": "Winner",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "winner"
            }
          ],
          "required": []
        }
      }
    },
    {
      "ref": "came-to",
      "slug": "games-came-to",
