      "description": "Who came to a game night.",
      "directional": true
    }
  ],
  "item_types": [
    {
      "ref": "game",
      "slug": "games-game",
      "label": "Game",
      "description": "A board game on the shelf or on the wishlist, with how it plays and what state it is in.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "min_players": {
            "title": "Min players",
            "type": "number",
            "x-menagerist": {
              "kind": "number"
            }
          },
          "max_players": {
            "title": "Max players",
            "type": "number",
            "x-menagerist": {
              "kind": "number"
            }
          },
          "play_time": {
            "title": "Play time",
            "type": "number",
            "minimum": 0,
            "multipleOf": 1,
            "x-menagerist": {
              "kind": "duration",
              "display": "words"
            }
          },
          "year": {
            "title": "Year",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          },
          "mechanics": {
            "title": "Mechanics",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Co-operative",
                "Dice",
                "Worker placement",
                "Set collection",
                "Bluffing",
                "Deck building"
              ]
            },
            "uniqueItems": true,
            "x-menagerist": {
              "kind": "multichoice"
            }
          },
          "weight": {
            "title": "Weight",
            "type": "string",
            "enum": [
              "Light",
              "Medium",
              "Heavy"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          },
          "rating": {
            "title": "Rating",
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "multipleOf": 1,
            "x-menagerist": {
              "kind": "rating"
            }
          },
          "condition": {
            "title": "Condition",
            "type": "string",
            "enum": [
              "New",
              "Good",
              "Worn"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          },
          "price_paid": {
            "title": "Price paid",
            "type": "object",
            "properties": {
              "value": {
                "title": "Value",
                "type": "number"
              },
              "currency": {
                "title": "Currency",
                "type": "string"
              }
            },
            "x-menagerist": {
              "kind": "money"
            }
          },
          "complete": {
            "title": "Complete?",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Text",
                  "type": "string"
                },
                "done": {
                  "title": "Done",
                  "type": "boolean"
                }
              }
            },
            "x-menagerist": {
              "kind": "checklist"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "longtext"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "min_players"
            },
            {
              "key": "max_players"
            },
            {
              "key": "play_time"
            },
            {
              "key": "year"
            },
            {
              "key": "mechanics"
            },
            {
              "key": "weight"
            },
            {
              "key": "rating"
            },
            {
              "key": "condition"
            },
            {
              "key": "price_paid"
            },
            {
              "key": "complete"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "rating"
              },
              {
                "key": "year"
              },
              {
                "key": "max_players"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "publisher",
      "slug": "games-publisher",
      "label": "Publisher",
      "description": "A company that publishes board games.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
