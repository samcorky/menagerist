{
  "format": "menagerist-example-pack",
  "version": 3,
  "id": "music",
  "presets": [
    {
      "ref": "signing-surface",
      "kind": "choice_list",
      "label": "Signing surface",
      "description": "Where on a record a signature is.",
      "definition": {
        "options": [
          "Cover",
          "Sleeve",
          "Inner sleeve",
          "Label",
          "Booklet",
          "Ticket"
        ]
      }
    }
  ],
  "relationship_types": [
    {
      "ref": "by",
      "slug": "music-by",
      "label": "By",
      "reverse_label": "Recordings",
      "description": "Which artist made a record.",
      "directional": true
    },
    {
      "ref": "featured",
      "slug": "music-featured",
      "label": "Featured",
      "reverse_label": "Played at",
      "description": "Which artists played at a gig.",
      "directional": true
    },
    {
      "ref": "at",
      "slug": "music-at",
      "label": "At",
      "reverse_label": "Hosted",
      "description": "Which venue a gig was held at.",
      "directional": true
    },
    {
      "ref": "went-to",
      "slug": "music-went-to",
      "label": "Went to",
      "reverse_label": "Went with",
      "description": "Who came along to a gig.",
      "directional": true
    },
    {
      "ref": "member-of",
      "slug": "music-member-of",
      "label": "Member of",
      "reverse_label": "Members",
      "description": "Who is, or was, in an artist, with their role and dates.",
      "directional": true,
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "role": {
            "title": "Role",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          },
          "joined": {
            "title": "Joined",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          },
          "left": {
            "title": "Left",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "role"
            },
            {
              "key": "joined"
            },
            {
              "key": "left"
            }
          ],
          "required": []
        }
      }
    },
    {
      "ref": "signed-by",
      "slug": "music-signed-by",
      "label": "Signed by",
      "reverse_label": "Signed",
      "description": "Who signed a record, and where on it.",
      "directional": true,
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "title": "Surface",
            "type": "string",
            "x-menagerist": {
              "list": {
                "$preset": "signing-surface"
              },
              "kind": "choice"
            }
          },
          "signed_on": {
            "title": "Signed on",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "surface"
            },
            {
              "key": "signed_on"
            }
          ],
          "required": []
        }
      }
    },
    {
      "ref": "signed-at",
      "slug": "music-signed-at",
      "label": "Signed at",
      "reverse_label": "Signings",
      "description": "The gig where a record was signed.",
      "directional": true
    }
  ],
  "item_types": [
    {
      "ref": "record",
      "slug": "music-record",
      "label": "Record",
      "description": "A record in the collection, with how it was pressed, how it plays and what it cost.",
      "cover": {
        "style": "sleeve"
      },
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pressing_year": {
            "title": "Pressing year",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          },
          "formats": {
            "title": "Formats",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "LP",
                "EP",
                "7 inch",
                "12 inch",
                "Cassette",
                "CD"
              ]
            },
            "uniqueItems": true,
            "x-menagerist": {
              "kind": "multichoice"
            }
          },
          "running_time": {
            "title": "Running time",
            "type": "number",
            "minimum": 0,
            "multipleOf": 1,
            "x-menagerist": {
              "kind": "duration"
            }
          },
          "condition": {
            "title": "Condition",
            "type": "string",
            "enum": [
              "Mint",
              "Near Mint",
              "Very Good Plus",
              "Very Good",
              "Good",
              "Fair",
              "Poor"
            ],
            "x-menagerist": {
              "kind": "choice"
            }
          },
          "price_paid": {
            "title": "Price paid",
            "type": "object",
            "properties": {
              "value": {
                "title": "Value",
                "type": "number"
              },
              "currency": {
                "title": "Currency",
                "type": "string"
              }
            },
            "x-menagerist": {
              "kind": "money"
            }
          },
          "notes": {
            "title": "Notes",
            "type": "string",
            "x-menagerist": {
              "kind": "longtext"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "pressing_year"
            },
            {
              "key": "formats"
            },
            {
              "key": "running_time"
            },
            {
              "key": "condition"
            },
            {
              "key": "price_paid"
            },
            {
              "key": "notes"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "condition"
              },
              {
                "key": "price_paid"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "artist",
      "slug": "music-artist",
      "label": "Artist",
      "description": "A band or solo performer.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "started": {
            "title": "Started",
            "type": "string",
            "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
            "x-menagerist": {
              "kind": "partialdate"
            }
          },
          "website": {
            "title": "Website",
            "type": "string",
            "format": "uri",
            "x-menagerist": {
              "kind": "url"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "started"
            },
            {
              "key": "website"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "started"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "gig",
      "slug": "music-gig",
      "label": "Gig",
      "description": "A night out to see an artist play live.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string",
            "format": "date",
            "x-menagerist": {
              "kind": "date"
            }
          },
          "rating": {
            "title": "Rating",
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "multipleOf": 1,
            "x-menagerist": {
              "kind": "rating"
            }
          },
          "ticket_stub_kept": {
            "title": "Ticket stub kept",
            "type": "boolean",
            "x-menagerist": {
              "kind": "boolean"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "date"
            },
            {
              "key": "rating"
            },
            {
              "key": "ticket_stub_kept"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "date"
              },
              {
                "key": "rating"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "venue",
      "slug": "music-venue",
      "label": "Venue",
      "description": "A place that hosts gigs.",
      "attributes_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "city": {
            "title": "City",
            "type": "string",
            "x-menagerist": {
              "kind": "text"
            }
          },
          "website": {
            "title": "Website",
            "type": "string",
            "format": "uri",
            "x-menagerist": {
              "kind": "url"
            }
          }
        },
        "x-menagerist": {
          "version": 1,
          "layout": [
            {
              "key": "city"
            },
            {
              "key": "website"
            }
          ],
          "required": [],
          "highlights": {
            "card": [
              {
                "key": "city"
              }
            ]
          }
        }
      }
    },
    {
      "ref": "person",
      "slug": "music-person",
      "label": "Person",
      "description": "A friend, or a member of a band."
    }
  ],
