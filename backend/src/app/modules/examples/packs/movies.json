                "Comedy",
                "Animation",
                "Family",
                "Horror",
                "Sci-fi",
                "Documentary",
                "Romance"
              ]
            },
            "uniqueItems": true,
            "x-menagerist": {
              "kind": "multichoice"
            }
          },
          "rating": {
            "title": "My rating",
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "multipleOf": 1,
            "x-menagerist": {
              "kind": "rating"
            }
          }
        },
