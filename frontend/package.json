{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --incremental",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check --cache --cache-strategy content . && eslint --cache --cache-strategy content .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write --cache --cache-strategy content .",
		"generate": "openapi-ts",
		"test": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@hey-api/openapi-ts": "0.99.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.66.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"bits-ui": "2.19.0",
		"clsx": "2.1.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.7.2",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.1",
		"@fontsource-variable/manrope": "^5.3.0",
		"@shimmer-from-structure/svelte": "^2.4.6",
		"bowser": "^2.14.1",
		"cronstrue": "^3.38.0",
		"date-fns": "^4.4.0",
		"svelte-sonner": "^1.2.1",
		"tinykeys": "^4.0.1"
	}
}
